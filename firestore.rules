rules_version = '2';
// 방(rooms/<6자리 코드>)만 쓸 수 있어요. 방 코드를 아는 사람은 누구나 보고 고칠 수 있어요.
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{code} {
      allow read, delete: if code.matches('^[0-9]{6}$');
      allow create, update: if code.matches('^[0-9]{6}$')
        && request.resource.data.code == code
        && request.resource.data.players is list && request.resource.data.players.size() <= 120
        && request.resource.data.courts is list && request.resource.data.courts.size() <= 8
        && request.resource.data.queue is list && request.resource.data.queue.size() <= 60
        && request.resource.data.history is list && request.resource.data.history.size() <= 80;
    }
  }
}
